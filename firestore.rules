rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string && emailKey.size() >= 3 && emailKey.size() <= 160;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'wajihaadil2@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAuthorizedStaff() {
      return isAdmin() || (
        isVerifiedUser() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/authorizedStaff/$(request.auth.token.email))
      );
    }

    // Query-safe read check (zero get()/exists() calls inside list rules)
    function canReadSharedDoc() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && (
          existing().ownerUid == request.auth.uid ||
          (
            'allowedEmails' in existing() &&
            existing().allowedEmails is list &&
            existing().allowedEmails.size() <= 20 &&
            request.auth.token.email is string &&
            request.auth.token.email in existing().allowedEmails
          )
        )
      );
    }

    function isValidAllowedEmails(listVal) {
      return listVal is list && listVal.size() <= 20 && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidOwnerUid(uid) {
      return uid is string && uid.size() >= 1 && uid.size() <= 128;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp;
    }

    function isValidAuthorizedStaff(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'addedByUid', 'createdAt']) &&
        data.keys().hasOnly(['email', 'name', 'role', 'addedByUid', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role in ['Branch Manager', 'Cashier', 'Waiter', 'Chef', 'Kitchen'] &&
        isValidOwnerUid(data.addedByUid) &&
        data.createdAt is timestamp;
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['id', 'name', 'address', 'phone', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'address', 'phone', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.status in ['Active', 'Inactive'] &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffUser(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'branch_id', 'email', 'avatar', 'phone', 'status', 'hourly_rate', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'role', 'branch_id', 'email', 'avatar', 'phone', 'status', 'hourly_rate', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role in ['Super Admin', 'Branch Manager', 'Cashier', 'Waiter', 'Chef', 'Kitchen'] &&
        data.branch_id is string && data.branch_id.size() >= 1 && data.branch_id.size() <= 128 &&
        data.email is string && data.email.size() <= 160 &&
        data.avatar is string && data.avatar.size() <= 500 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.status in ['Active', 'Inactive'] &&
        data.hourly_rate is number && data.hourly_rate >= 0 && data.hourly_rate <= 1000000 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'price', 'stock', 'image', 'availability', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'price', 'stock', 'image', 'availability', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.price is number && data.price > 0 && data.price <= 10000000 &&
        data.stock is number && data.stock >= 0 && data.stock <= 1000000 &&
        data.image is string && data.image.size() <= 500 &&
        data.availability is list && data.availability.size() <= 50 && (data.availability.size() == 0 || data.availability[0] is string) &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'order_number', 'branch_id', 'table_number', 'customer_name', 'customer_phone', 'order_type', 'status', 'items', 'subtotal', 'discount_amount', 'tax_amount', 'total_amount', 'payment_method', 'custom_notes', 'created_by', 'created_at', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'order_number', 'branch_id', 'table_number', 'customer_name', 'customer_phone', 'order_type', 'status', 'items', 'subtotal', 'discount_amount', 'tax_amount', 'total_amount', 'payment_method', 'custom_notes', 'created_by', 'created_at', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.order_number is string && data.order_number.size() >= 2 && data.order_number.size() <= 32 &&
        isValidId(data.branch_id) &&
        data.table_number is string && data.table_number.size() >= 1 && data.table_number.size() <= 40 &&
        data.customer_name is string && data.customer_name.size() <= 120 &&
        data.customer_phone is string && data.customer_phone.size() <= 40 &&
        data.order_type in ['Dine-in', 'Takeaway', 'Delivery'] &&
        data.status in ['New Orders', 'In Preparation', 'Ready for Pickup', 'Completed', 'Cancelled'] &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discount_amount is number && data.discount_amount >= 0 &&
        data.tax_amount is number && data.tax_amount >= 0 &&
        data.total_amount is number && data.total_amount >= 0 && data.total_amount <= 100000000 &&
        data.payment_method in ['Cash', 'Card', 'Gift Card'] &&
        data.custom_notes is string && data.custom_notes.size() <= 300 &&
        data.created_by is string && data.created_by.size() <= 120 &&
        data.created_at is string && data.created_at.size() >= 4 && data.created_at.size() <= 64 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'name', 'quantity', 'reorder_level', 'unit', 'branch_id', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'quantity', 'reorder_level', 'unit', 'branch_id', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.quantity is number && data.quantity >= 0 && data.quantity <= 10000000 &&
        data.reorder_level is number && data.reorder_level >= 0 && data.reorder_level <= 10000000 &&
        data.unit is string && data.unit.size() <= 30 &&
        isValidId(data.branch_id) &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'email', 'points', 'totalSpent', 'visits', 'favorite', 'rating', 'feedback', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'phone', 'email', 'points', 'totalSpent', 'visits', 'favorite', 'rating', 'feedback', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.email is string && data.email.size() <= 160 &&
        data.points is number && data.points >= 0 &&
        data.totalSpent is number && data.totalSpent >= 0 &&
        data.visits is number && data.visits >= 0 &&
        data.favorite is string && data.favorite.size() <= 150 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.feedback is string && data.feedback.size() <= 500 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGiftCard(data) {
      return data.keys().hasAll(['id', 'code', 'balance', 'initialValue', 'customer', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'balance', 'initialValue', 'customer', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 3 && data.code.size() <= 64 &&
        data.balance is number && data.balance >= 0 &&
        data.initialValue is number && data.initialValue > 0 &&
        data.customer is string && data.customer.size() >= 1 && data.customer.size() <= 120 &&
        data.status in ['Active', 'Redeemed', 'Inactive'] &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPromoCode(data) {
      return data.keys().hasAll(['id', 'code', 'discountType', 'value', 'usageCount', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'discountType', 'value', 'usageCount', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 40 &&
        data.discountType in ['percentage', 'flat'] &&
        data.value is number && data.value > 0 &&
        data.usageCount is number && data.usageCount >= 0 &&
        data.status in ['Active', 'Inactive'] &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['id', 'guestName', 'phone', 'guests', 'date', 'time', 'branchId', 'table', 'status', 'notes', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'guestName', 'phone', 'guests', 'date', 'time', 'branchId', 'table', 'status', 'notes', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 40 &&
        data.guests is number && data.guests >= 1 && data.guests <= 200 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.time is string && data.time.size() >= 2 && data.time.size() <= 32 &&
        isValidId(data.branchId) &&
        data.table is string && data.table.size() >= 1 && data.table.size() <= 40 &&
        data.status in ['Confirmed', 'Waitlist', 'Seated', 'Cancelled'] &&
        data.notes is string && data.notes.size() <= 300 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShift(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'role', 'date', 'startTime', 'endTime', 'branchId', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'role', 'date', 'startTime', 'endTime', 'branchId', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 60 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.startTime is string && data.startTime.size() >= 2 && data.startTime.size() <= 32 &&
        data.endTime is string && data.endTime.size() >= 2 && data.endTime.size() <= 32 &&
        isValidId(data.branchId) &&
        data.status in ['Scheduled', 'Completed', 'Cancelled'] &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'clockIn', 'clockOut', 'totalHours', 'date', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'clockIn', 'clockOut', 'totalHours', 'date', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.clockIn is string && data.clockIn.size() >= 2 && data.clockIn.size() <= 40 &&
        data.clockOut is string && data.clockOut.size() >= 2 && data.clockOut.size() <= 40 &&
        data.totalHours is number && data.totalHours >= 0 && data.totalHours <= 24 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['id', 'menuName', 'cogs', 'sellingPrice', 'ingredients', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'menuName', 'cogs', 'sellingPrice', 'ingredients', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.menuName is string && data.menuName.size() >= 1 && data.menuName.size() <= 150 &&
        data.cogs is number && data.cogs >= 0 &&
        data.sellingPrice is number && data.sellingPrice > 0 &&
        data.ingredients is list && data.ingredients.size() <= 30 && (data.ingredients.size() == 0 || data.ingredients[0] is map) &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVoidLog(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'item', 'amount', 'reason', 'voidedBy', 'date', 'ownerUid', 'allowedEmails', 'createdAt']) &&
        data.keys().hasOnly(['id', 'orderNumber', 'item', 'amount', 'reason', 'voidedBy', 'date', 'ownerUid', 'allowedEmails', 'createdAt']) &&
        isValidId(data.id) &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 32 &&
        data.item is string && data.item.size() >= 1 && data.item.size() <= 150 &&
        data.amount is number && data.amount >= 0 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        data.voidedBy is string && data.voidedBy.size() >= 1 && data.voidedBy.size() <= 120 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 64 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp;
    }

    function isValidWasteLog(data) {
      return data.keys().hasAll(['id', 'ingredient', 'qty', 'cost', 'reason', 'branchId', 'date', 'ownerUid', 'allowedEmails', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ingredient', 'qty', 'cost', 'reason', 'branchId', 'date', 'ownerUid', 'allowedEmails', 'createdAt']) &&
        isValidId(data.id) &&
        data.ingredient is string && data.ingredient.size() >= 1 && data.ingredient.size() <= 150 &&
        data.qty is string && data.qty.size() >= 1 && data.qty.size() <= 50 &&
        data.cost is number && data.cost >= 0 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        isValidId(data.branchId) &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp;
    }

    function isValidCashRegister(data) {
      return data.keys().hasAll(['id', 'isOpen', 'openingBalance', 'currentCash', 'cashDrops', 'ownerUid', 'allowedEmails', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'isOpen', 'openingBalance', 'currentCash', 'cashDrops', 'ownerUid', 'allowedEmails', 'updatedAt']) &&
        isValidId(data.id) &&
        data.isOpen is bool &&
        data.openingBalance is number && data.openingBalance >= 0 &&
        data.currentCash is number && data.currentCash >= 0 &&
        data.cashDrops is list && data.cashDrops.size() <= 100 && (data.cashDrops.size() == 0 || data.cashDrops[0] is map) &&
        isValidOwnerUid(data.ownerUid) &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.updatedAt is timestamp;
    }

    // --- CONNECTION PROBE ---
    match /test/connection {
      allow get: if isVerifiedUser();
    }

    // --- ACCESS CONTROL COLLECTIONS ---
    match /admins/{uid} {
      allow get: if isAdmin() || (isVerifiedUser() && request.auth.uid == uid);
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminRole(incoming()) && incoming().uid == uid && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminRole(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    match /authorizedStaff/{emailKey} {
      allow get: if isAdmin() || (isVerifiedUser() && request.auth.token.email == emailKey);
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().addedByUid == request.auth.uid);
      allow create: if isAdmin() && isValidEmailKey(emailKey) && isValidAuthorizedStaff(incoming()) && incoming().email == emailKey && incoming().addedByUid == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidEmailKey(emailKey) && isValidAuthorizedStaff(incoming()) && incoming().email == existing().email && incoming().addedByUid == existing().addedByUid && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role']);
      allow delete: if isAdmin() && isValidEmailKey(emailKey);
    }

    // --- CORE RESTAURANT COLLECTIONS ---
    match /branches/{branchId} {
      allow get: if (isAuthorizedStaff() || canReadSharedDoc()) && isValidId(branchId);
      allow list: if canReadSharedDoc();
      allow create: if isAdmin() && isValidId(branchId) && isValidBranch(incoming()) && incoming().id == branchId && incoming().ownerUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(branchId) && isValidBranch(incoming()) && incoming().id == existing().id && incoming().ownerUid == existing().ownerUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'status', 'allowedEmails', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(branchId);
    }

    match /staffUsers/{staffId} {
      allow get: if (isAuthorizedStaff() || canReadSharedDoc()) && isValidId(staffId);
      allow list: if canReadSharedDoc();
      allow create: if isAdmin() && isValidId(staffId) && isValidStaffUser(incoming()) && incoming().id == staffId && incoming().ownerUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(staffId) && isValidStaffUser(incoming()) && incoming().id == existing().id && incoming().ownerUid == existing().ownerUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'branch_id', 'email', 'phone', 'status', 'hourly_rate', 'avatar', 'allowedEmails', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(staffId);
    }

    match /menuItems/{menuItemId} {
      allow get: if (isAuthorizedStaff() || canReadSharedDoc()) && isValidId(menuItemId);
      allow list: if canReadSharedDoc();
      allow create: if isAuthorizedStaff() && isValidId(menuItemId) && isValidMenuItem(incoming()) && incoming().id == menuItemId && incoming().ownerUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAuthorizedStaff() && isValidId(menuItemId) && isValidMenuItem(incoming()) && incoming().id == existing().id && incoming().ownerUid == existing().ownerUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'stock', 'image', 'availability', 'allowedEmails', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
      );
      allow delete: if isAuthorizedStaff() && isValidId(menuItemId);
    }

    match /orders/{orderId} {
      allow get: if (isAuthorizedStaff() || canReadSharedDoc()) && isValidId(orderId);
      allow list: if canReadSharedDoc();
      allow create: if isAuthorizedStaff() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().id == orderId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/branches/$(incoming().branch_id));
      allow update: if isAuthorizedStaff() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            !(existing().status in ['Completed', 'Cancelled']) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['branch_id', 'table_number', 'customer_name', 'customer_phone', 'order_type', 'status', 'items', 'subtotal', 'discount_amount', 'tax_amount', 'total_amount', 'payment_method', 'custom_notes', 'updatedAt'])
            )
          )
        );
      allow delete: if isAuthorizedStaff() && isValidId(orderId);
    }

    match /inventory/{inventoryId} {
      allow get: if (isAuthorizedStaff() || canReadSharedDoc()) && isValidId(inventoryId);
      allow list: if canReadSharedDoc();
      allow create: if isAuthorizedStaff() && isValidId(inventoryId) && isValidInventoryItem(incoming()) &&
        incoming().id == inventoryId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/branches/$(incoming().branch_id));
      allow update: if isAuthorizedStaff() && isValidId(inventoryId) && isValidInventoryItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
