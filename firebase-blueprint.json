{
  "entities": {
    "Branch": {
      "title": "Branch",
      "description": "A restaurant branch location for Royal India By Spicy Twist.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "address": { "type": "string", "minLength": 0, "maxLength": 300 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 40 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails for multi-laptop sync (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address", "phone", "status", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "A staff member profile, role, branch assignment, and hourly wage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["Super Admin", "Branch Manager", "Cashier", "Waiter", "Chef", "Kitchen"] },
        "branch_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "avatar": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "hourly_rate": { "type": "number" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "branch_id", "email", "avatar", "phone", "status", "hourly_rate", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "AuthorizedStaff": {
      "title": "AuthorizedStaff",
      "description": "Email allowlist document granting verified Google accounts access to restaurant operations.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["Branch Manager", "Cashier", "Waiter", "Chef", "Kitchen"] },
        "addedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "role", "addedByUid", "createdAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Explicit administrator privilege document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "A restaurant menu dish or beverage synced across POS and branches.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "image": { "type": "string", "maxLength": 500 },
        "availability": { "type": "array", "description": "Branch IDs where this dish is available (max 50)." },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "price", "stock", "image", "availability", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer POS order synced in real time to the Kitchen Display System (KDS).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "order_number": { "type": "string", "minLength": 2, "maxLength": 32 },
        "branch_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "table_number": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customer_name": { "type": "string", "maxLength": 120 },
        "customer_phone": { "type": "string", "maxLength": 40 },
        "order_type": { "type": "string", "enum": ["Dine-in", "Takeaway", "Delivery"] },
        "status": { "type": "string", "enum": ["New Orders", "In Preparation", "Ready for Pickup", "Completed", "Cancelled"] },
        "items": { "type": "array", "description": "Ordered line items (1 to 50 items)." },
        "subtotal": { "type": "number" },
        "discount_amount": { "type": "number" },
        "tax_amount": { "type": "number" },
        "total_amount": { "type": "number" },
        "payment_method": { "type": "string", "enum": ["Cash", "Card", "Gift Card"] },
        "custom_notes": { "type": "string", "maxLength": 300 },
        "created_by": { "type": "string", "maxLength": 120 },
        "created_at": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "order_number", "branch_id", "table_number", "customer_name", "customer_phone", "order_type", "status", "items", "subtotal", "discount_amount", "tax_amount", "total_amount", "payment_method", "custom_notes", "created_by", "created_at", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Stock and ingredient levels per branch.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "quantity": { "type": "number" },
        "reorder_level": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "branch_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "quantity", "reorder_level", "unit", "branch_id", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "CRM customer record including loyalty points and review.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "points": { "type": "number" },
        "totalSpent": { "type": "number" },
        "visits": { "type": "number" },
        "favorite": { "type": "string", "maxLength": 150 },
        "rating": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 500 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "email", "points", "totalSpent", "visits", "favorite", "rating", "feedback", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "GiftCard": {
      "title": "GiftCard",
      "description": "Issued digital gift card voucher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 3, "maxLength": 64 },
        "balance": { "type": "number" },
        "initialValue": { "type": "number" },
        "customer": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["Active", "Redeemed", "Inactive"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "balance", "initialValue", "customer", "status", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Promotional discount campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 40 },
        "discountType": { "type": "string", "enum": ["percentage", "flat"] },
        "value": { "type": "number" },
        "usageCount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "discountType", "value", "usageCount", "status", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Table booking or walk-in waitlist entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guestName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "guests": { "type": "number" },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "time": { "type": "string", "minLength": 2, "maxLength": 32 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "table": { "type": "string", "minLength": 1, "maxLength": 40 },
        "status": { "type": "string", "enum": ["Confirmed", "Waitlist", "Seated", "Cancelled"] },
        "notes": { "type": "string", "maxLength": 300 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "guestName", "phone", "guests", "date", "time", "branchId", "table", "status", "notes", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Scheduled staff shift.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 60 },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "startTime": { "type": "string", "minLength": 2, "maxLength": 32 },
        "endTime": { "type": "string", "minLength": 2, "maxLength": 32 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["Scheduled", "Completed", "Cancelled"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "role", "date", "startTime", "endTime", "branchId", "status", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Staff time clock attendance record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "clockIn": { "type": "string", "minLength": 2, "maxLength": 40 },
        "clockOut": { "type": "string", "minLength": 2, "maxLength": 40 },
        "totalHours": { "type": "number" },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "clockIn", "clockOut", "totalHours", "date", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Dish recipe and COGS food costing formula.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "menuName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "cogs": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "ingredients": { "type": "array", "description": "Ingredient breakdown entries (max 30)." },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "menuName", "cogs", "sellingPrice", "ingredients", "ownerUid", "allowedEmails", "createdAt", "updatedAt"]
    },
    "VoidLog": {
      "title": "VoidLog",
      "description": "Audit record of voided orders or items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "item": { "type": "string", "minLength": 1, "maxLength": 150 },
        "amount": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "voidedBy": { "type": "string", "minLength": 1, "maxLength": 120 },
        "date": { "type": "string", "minLength": 4, "maxLength": 64 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "item", "amount", "reason", "voidedBy", "date", "ownerUid", "allowedEmails", "createdAt"]
    },
    "WasteLog": {
      "title": "WasteLog",
      "description": "Food waste and spoilage loss entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ingredient": { "type": "string", "minLength": 1, "maxLength": 150 },
        "qty": { "type": "string", "minLength": 1, "maxLength": 50 },
        "cost": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ingredient", "qty", "cost", "reason", "branchId", "date", "ownerUid", "allowedEmails", "createdAt"]
    },
    "CashRegister": {
      "title": "CashRegister",
      "description": "Cash register float balance and cash drops.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isOpen": { "type": "boolean" },
        "openingBalance": { "type": "number" },
        "currentCash": { "type": "number" },
        "cashDrops": { "type": "array", "description": "Cash drop events (max 100)." },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedEmails": { "type": "array", "description": "Authorized staff emails (max 20)." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "isOpen", "openingBalance", "currentCash", "cashDrops", "ownerUid", "allowedEmails", "updatedAt"]
    }
  },
  "firestore": {
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Restaurant branch locations."
    },
    "/staffUsers/{staffId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Restaurant staff directory records."
    },
    "/authorizedStaff/{emailId}": {
      "schema": { "$ref": "#/entities/AuthorizedStaff" },
      "description": "Authorized staff emails for multi-laptop Firebase sync."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Explicit admin UIDs."
    },
    "/menuItems/{menuItemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Live menu catalog shared across POS terminals."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Real-time POS and KDS orders."
    },
    "/inventory/{inventoryId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Ingredient and packaging stock levels per branch."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer CRM profiles, loyalty points, and feedback."
    },
    "/giftCards/{giftCardId}": {
      "schema": { "$ref": "#/entities/GiftCard" },
      "description": "Issued digital gift cards."
    },
    "/promos/{promoId}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "Active discount promo codes."
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/Reservation" },
      "description": "Table reservations and walk-in waitlist."
    },
    "/shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/Shift" },
      "description": "Scheduled staff shifts."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Staff clock-in and clock-out logs."
    },
    "/recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/Recipe" },
      "description": "Dish recipes and COGS costing."
    },
    "/voidLogs/{voidLogId}": {
      "schema": { "$ref": "#/entities/VoidLog" },
      "description": "Immutable audit log of voided orders."
    },
    "/wasteLogs/{wasteLogId}": {
      "schema": { "$ref": "#/entities/WasteLog" },
      "description": "Food waste and spoilage logs."
    },
    "/registers/{registerId}": {
      "schema": { "$ref": "#/entities/CashRegister" },
      "description": "Cash drawer balance and cash drop audit."
    }
  }
}
